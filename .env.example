# Browser-visible values: use only the Supabase project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key

# Set this to the public application origin for auth confirmation and password reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
